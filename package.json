{
  "name": "ardechoise-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:site": "vite --config vite.site.config.js",
    "test": "node --test",
    "build": "vite build",
    "build:site": "vite build --config vite.site.config.js",
    "build:pages": "vite build --config vite.site.config.js --mode pages",
    "build:android": "vite build --config vite.android.config.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:site": "vite preview --config vite.site.config.js",
    "preview:pages": "vite preview --config vite.site.config.js --mode pages",
    "android:prepare": "npm run build:android && node scripts/android-project.mjs",
    "android:open": "cap open android",
    "android:apk": "npm run android:prepare && node scripts/android-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1"
  }
}
